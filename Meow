      <img src="https://media.discordapp.net/attachments/1018192135679381526/1412434822705451139/221_Sem_Titulo_20250902095112.png?ex=68b847ef&is=68b6f66f&hm=413427eb703dee36ae4e123873ea024f7e067a331bfaaabca90f01940c677617&=&format=webp&quality=lossless&width=513&height=856" class="w3-round w3-image" alt="Table Setting" width="600" height="950" style="opacity:0.95;">
